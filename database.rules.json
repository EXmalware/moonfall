{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('hostId').val() == auth.uid",
        "phase": {
          ".write": "auth != null && (auth.uid == data.parent().child('hostId').val() || auth.uid == data.parent().child('moderatorId').val()) && ((data.val() == 'lobi' && newData.val() == 'malam') || (data.val() == 'malam' && newData.val() == 'siang') || (data.val() == 'siang' && newData.val() == 'malam'))",
          ".validate": "newData.isString() && (newData.val() == 'lobi' || newData.val() == 'malam' || newData.val() == 'siang')"
        },
        "round": {
          ".write": "auth != null && (auth.uid == data.parent().child('hostId').val() || auth.uid == data.parent().child('moderatorId').val())",
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "moderatorId": {
          ".write": "auth != null && (auth.uid == data.parent().child('hostId').val() || (data.val() == null && data.parent().child('moderator').val() == 'player' && newData.val() == auth.uid)) && (newData.val() == null || newData.isString())",
          ".validate": "newData.val() == null || newData.isString()"
        },
        "nightResult": {
          ".write": "auth != null && (auth.uid == data.parent().child('hostId').val() || auth.uid == data.parent().child('moderatorId').val())",
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "winner": {
          ".write": "auth != null && (auth.uid == data.parent().child('hostId').val() || auth.uid == data.parent().child('moderatorId').val())",
          ".validate": "newData.isString() && (newData.val() == 'WARGA' || newData.val() == 'WEREWOLF' || newData.val() == 'TANNER')"
        },
        "players": {
          "$playerId": {
            ".write": "auth != null && (auth.uid == root.child('rooms').child($roomId).child('hostId').val() || auth.uid == root.child('rooms').child($roomId).child('moderatorId').val() || (auth.uid == $playerId && (!data.exists() || (newData.child('id').val() == data.child('id').val() && newData.child('alias').val() == data.child('alias').val() && newData.child('alive').val() == data.child('alive').val() && newData.child('status').val() == data.child('status').val()))))",
            ".validate": "newData.hasChildren(['id', 'alias', 'alive']) && newData.child('id').val() == $playerId && newData.child('alive').isBoolean() && (data.exists() || newData.child('alive').val() == true) && (data.exists() || newData.child('status').val() == 'Ready' || (newData.child('status').val() == 'Host' && auth.uid == root.child('rooms').child($roomId).child('hostId').val()) || (newData.child('status').val() == 'Moderator' && root.child('rooms').child($roomId).child('moderator').val() == 'player' && auth.uid == root.child('rooms').child($roomId).child('moderatorId').val()))"
          }
        },
        "votes": {
          "$voterId": {
            ".write": "auth != null && auth.uid == $voterId && root.child('rooms').child($roomId).child('phase').val() == 'siang' && root.child('rooms').child($roomId).child('players').child(auth.uid).child('alive').val() == true && root.child('rooms').child($roomId).child('players').child(auth.uid).child('status').val() != 'Moderator'",
            ".validate": "newData.isString() && root.child('rooms').child($roomId).child('players').child(newData.val()).child('alive').val() == true && root.child('rooms').child($roomId).child('players').child(newData.val()).child('status').val() != 'Moderator'"
          }
        },
        "nightActions": {
          "$playerId": {
            ".write": "auth != null && auth.uid == $playerId && root.child('rooms').child($roomId).child('phase').val() == 'malam' && root.child('rooms').child($roomId).child('players').child(auth.uid).child('alive').val() == true",
            ".validate": "newData.hasChildren(['action', 'round']) && newData.child('action').isString() && newData.child('action').val().length <= 40"
          }
        },
        "chatMessages": {
          "$messageId": {
            ".write": "auth != null && root.child('rooms').child($roomId).child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['id', 'alias', 'text']) && newData.child('alias').val() == root.child('rooms').child($roomId).child('players').child(auth.uid).child('alias').val() && newData.child('text').isString() && newData.child('text').val().length <= 500"
          }
        }
      }
    },
    "privateRoles": {
      "$roomId": {
        ".read": "auth != null && (auth.uid == root.child('rooms').child($roomId).child('hostId').val() || auth.uid == root.child('rooms').child($roomId).child('moderatorId').val())",
        "$playerId": {
          ".read": "auth != null && (auth.uid == $playerId || auth.uid == root.child('rooms').child($roomId).child('hostId').val() || auth.uid == root.child('rooms').child($roomId).child('moderatorId').val())",
          ".write": "auth != null && (auth.uid == root.child('rooms').child($roomId).child('hostId').val() || auth.uid == root.child('rooms').child($roomId).child('moderatorId').val())",
          ".validate": "newData.hasChildren(['name', 'faction'])"
        }
      }
    },
    "werewolfChat": {
      "$roomId": {
        ".read": "auth != null && root.child('privateRoles').child($roomId).child(auth.uid).child('faction').val() == 'KELOMPOK JAHAT'",
        "$messageId": {
          ".write": "auth != null && root.child('privateRoles').child($roomId).child(auth.uid).child('faction').val() == 'KELOMPOK JAHAT'",
          ".validate": "newData.hasChildren(['id', 'alias', 'text']) && newData.child('alias').val() == root.child('rooms').child($roomId).child('players').child(auth.uid).child('alias').val() && newData.child('text').isString() && newData.child('text').val().length <= 500"
        }
      }
    },
    "roleResults": {
      "$roomId": {
        "$playerId": {
          ".read": "auth != null && auth.uid == $playerId",
          ".write": "auth != null && (auth.uid == root.child('rooms').child($roomId).child('hostId').val() || auth.uid == root.child('rooms').child($roomId).child('moderatorId').val())",
          ".validate": "newData.isString() && newData.val().length <= 500"
        }
      }
    }
  }
}
