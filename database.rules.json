{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "players": {
          "$playerId": {
            ".validate": "newData.hasChildren(['id', 'alias', 'alive'])"
          }
        },
        "privateRoles": {
          ".read": false,
          "$playerId": {
            ".read": "auth != null && auth.uid === $playerId",
            ".write": "auth != null && (auth.uid === $playerId || auth.uid === data.parent().parent().child('hostId').val())"
          }
        }
      }
    }
  }
}
